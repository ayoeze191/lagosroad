{
  "name": "lagos-road-racer",
  "private": true,
  "workspaces": ["client", "server", "tools"],
  "scripts": {
    "map:build": "npm --workspace tools run build:map",
    "map:list": "npm --workspace tools run list:areas",
    "map:validate": "npm --workspace tools run validate:map",
    "test": "npm --workspace tools run test && npm --workspace server run test",
    "map:stage": "npm --workspace tools run stage:maps",
    "client:dev": "npm --workspace client run dev",
    "dev": "concurrently -n race-server,client -c blue,green \"npm run server:dev\" \"npm run client:dev\"",
    "client:build": "npm --workspace client run build",
    "server:dev": "npm --workspace server run dev",
    "server:build": "npm --workspace server run build"
  } ,
  "devDependencies": { "concurrently": "^9.1.2" }
}
